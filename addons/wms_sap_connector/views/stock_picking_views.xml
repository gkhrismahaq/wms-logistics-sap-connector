<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_sap" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.sap</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_sap_goods_receipt_webhook"
                        string="Retry SAP Webhook"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'done' or sap_sync_status == 'synced' or not sap_doc_number"/>
                <button name="%(wms_sap_connector.action_report_surat_jalan)d"
                        string="Print Surat Jalan"
                        type="action"
                        class="btn-primary"
                        invisible="picking_type_code != 'outgoing'"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sap_doc_number" placeholder="e.g. PO-SAP-2026-001 or SO-DELIV-2026-901"/>
                <field name="sap_sync_status" widget="badge"
                       decoration-success="sap_sync_status == 'synced'"
                       decoration-danger="sap_sync_status == 'failed'"
                       decoration-warning="sap_sync_status == 'pending'"
                       decoration-info="sap_sync_status == 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/tree//field[@name='location_dest_id']" position="attributes">
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Fleet &amp; Dispatch" name="page_fleet_dispatch">
                    <group>
                        <group string="Fleet Assignment">
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="driver_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Cargo Load Summary">
                            <field name="total_weight"/>
                            <field name="total_volume"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_inherit_sap" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.sap</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="vehicle_id" optional="show"/>
                <field name="driver_id" optional="hide"/>
                <field name="total_weight" optional="hide"/>
                <field name="total_volume" optional="hide"/>
                <field name="sap_doc_number" optional="show"/>
                <field name="sap_sync_status" widget="badge" optional="show"
                       decoration-success="sap_sync_status == 'synced'"
                       decoration-danger="sap_sync_status == 'failed'"
                       decoration-warning="sap_sync_status == 'pending'"
                       decoration-info="sap_sync_status == 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search_inherit_sap" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.sap</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="sap_doc_number" string="SAP Document Number"
                       filter_domain="[('sap_doc_number', 'ilike', self)]"/>
                <separator/>
                <filter string="Assigned Vehicle" name="filter_has_vehicle"
                        domain="[('vehicle_id', '!=', False)]"/>
                <filter string="SAP Sync Failed" name="filter_sap_failed"
                        domain="[('sap_sync_status', '=', 'failed')]"/>
                <filter string="SAP Synced" name="filter_sap_synced"
                        domain="[('sap_sync_status', '=', 'synced')]"/>
                <filter string="SAP Draft" name="filter_sap_draft"
                        domain="[('sap_sync_status', '=', 'draft')]"/>
            </xpath>
            <xpath expr="//group[@expand='0']" position="inside">
                <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter string="Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                <filter string="SAP Sync Status" name="group_sap_sync_status"
                        context="{'group_by': 'sap_sync_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
