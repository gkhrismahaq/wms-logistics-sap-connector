<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_sap" model="ir.ui.view">
        <field name="name">product.template.only.form.inherit.sap</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="sap_material_code" placeholder="e.g. MAT-KOPI-01"/>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_inherit_sap" model="ir.ui.view">
        <field name="name">product.product.normal.form.inherit.sap</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="sap_material_code" placeholder="e.g. MAT-KOPI-01"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_inherit_sap" model="ir.ui.view">
        <field name="name">product.template.search.inherit.sap</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sap_material_code"/>
            </xpath>
        </field>
    </record>
</odoo>
