<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_wms_logistics" model="ir.module.category">
            <field name="name">WMS Logistics</field>
            <field name="description">Access rights management for WMS &amp; SAP Integration</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_wms_operator" model="res.groups">
            <field name="name">Warehouse Operator</field>
            <field name="category_id" ref="module_category_wms_logistics" />
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_multi_locations'))]" />
            <field name="comment">Operational access to barcode scanning, picking documents, and bin allocation.</field>
        </record>

        <record id="group_wms_dispatcher" model="res.groups">
            <field name="name">Logistics Dispatcher</field>
            <field name="category_id" ref="module_category_wms_logistics" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
            <field name="comment">Fleet management, driver assignment, delivery slips, and Proof of Delivery (POD).</field>
        </record>

        <record id="group_wms_manager" model="res.groups">
            <field name="name">Warehouse Manager</field>
            <field name="category_id" ref="module_category_wms_logistics" />
            <field name="implied_ids" eval="[(4, ref('group_wms_operator')), (4, ref('group_wms_dispatcher'))]" />
            <field name="comment">Full administrative access to warehouse operations and SAP integration logs.</field>
        </record>
    </data>
</odoo>
